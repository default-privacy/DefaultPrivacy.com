# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/reports/lighthouse-*.json
!/reports/lighthouse-gate-summary.json

# next.js
/.next/
/out/

# production
/build

# Cursor IDE (local only — do not commit)
.cursor/

# Claude Code (local only — do not commit, same as .cursor/)
.claude/
CLAUDE.md

# misc
.DS_Store
*.pem
*.code-workspace

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local docs (not committed)
/docs/

# local drafts (not committed — promote files out to their real home when ready)
/drafts/

# data backups and exports
/data/
/backups/

