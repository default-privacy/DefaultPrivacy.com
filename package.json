{
  "name": "default-privacy",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "VERCEL_PREVIEW_COMMENTS_ENABLED=0 next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse:gate": "node scripts/lighthouse-gate.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=.env --env-file=.env.local ./scripts/run-migrations.ts",
    "db:migrate:http": "DRIZZLE_USE_NEON_HTTP_MIGRATOR=true bun --env-file=.env --env-file=.env.local ./scripts/run-migrations.ts",
    "db:migrate:ci": "bun ./scripts/run-migrations.ts",
    "db:baseline": "bun --env-file=.env --env-file=.env.local ./scripts/baseline-drizzle-migrations.ts",
    "db:migrate:tcp": "bun --env-file=.env --env-file=.env.local run drizzle-kit migrate",
    "db:migrate:wake": "bun run scripts/wake-database.ts && bun --env-file=.env --env-file=.env.local run drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run scripts/seed-tools.ts",
    "check:tracker-alts": "bun --env-file=.env --env-file=.env.local run scripts/check-tracker-alternatives.ts",
    "dns:check": "bun scripts/check-dns.ts",
    "usage:report": "bun run scripts/usage-report.ts",
    "smoke:mcp:prod": "bun scripts/mcp-prod-smoke.mjs",
    "sync:tosdr": "bun scripts/sync-tosdr.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
