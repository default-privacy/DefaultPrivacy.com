# ═══════════════════════════════════════════════════════════════════════════════
# Default Privacy: environment variables
# Copy this file to .env.local and fill in the values. Everything is optional and
# defaulted (see src/lib/env.ts); a missing service just logs OFF — the build runs.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Core ─────────────────────────────────────────────────────────────────────
# PostgreSQL connection string. A URL containing "neon.tech" auto-selects the
# neon-http driver; anything else uses the local postgres-js driver.
#   Local Docker:  postgresql://dp:devpass@127.0.0.1:5432/defaultprivacy
DATABASE_URL="postgresql://dp:devpass@127.0.0.1:5432/defaultprivacy"

# Optional — URL used only by `bun run db:migrate` (scripts/db-migrate-url.ts).
# For Neon prefer the Direct (non-pooler) URL here. Migrations are run manually
# (the CI auto-migrate trigger was removed).
# MIGRATE_DATABASE_URL="postgresql://...neon.tech/neondb?sslmode=require"

# Public-facing URL (redirects, OG tags, sitemap).
NEXT_PUBLIC_URL="http://localhost:3000"

# ─── Website scanner ──────────────────────────────────────────────────────────
# "true" disables Playwright and returns mock scan data (CI / serverless / no browsers).
# DISABLE_PLAYWRIGHT_SCANNER="false"

# ─── DNS-leak test infrastructure (optional separate probe server) ────────────
# Without these, the DNS-leak test falls back to a basic client-side check.
# DNS_LEAK_SERVER_URL="http://<VPS_IP>:8053"
# DNS_LEAK_SERVER_SECRET="your-shared-secret"

# ─── Scanner worker (optional separate scan server) ─────────────────────────────────
# When BOTH are set, real scans run on that server (Chromium); unset => local/mock.
# A worker error hard-fails the scan ("Scan failed") — it never serves mock data.
# SCAN_WORKER_URL="https://scan.defaultprivacy.com"
# SCAN_WORKER_SECRET="your-shared-secret"

# ─── Email (Resend) — optional notifications ──────────────────────────────────
# RESEND_API_KEY="re_..."
# ADMIN_EMAIL="admin@defaultprivacy.com"
